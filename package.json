{
  "name": "japan-national-holidays-api",
  "version": "1.0.0",
  "description": "日本の国民の祝日 REST API と MCP サーバー",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && npm run generate-swagger",
    "test": "HOLIDAYS_SKIP_FETCH=1 vitest run",
    "test:watch": "HOLIDAYS_SKIP_FETCH=1 vitest",
    "update-csv": "tsx scripts/update-bundled-csv.ts",
    "generate-swagger": "HOLIDAYS_SKIP_FETCH=1 tsx scripts/generate-swagger.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fuse.js": "^7.5.0",
    "hono": "^4.13.7",
    "iconv-lite": "^0.7.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
